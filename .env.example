# OpenAI API Key — necessário para embeddings e geração
OPENAI_API_KEY=sk-your-key-here

# API Key para proteger o acesso (defina sua senha aqui)
TCC_API_KEY="sua-senha-secreta"



# Modelo de embedding (padrão: text-embedding-3-large)
EMBEDDING_MODEL=text-embedding-3-large

# Modelo de geração (padrão: gpt-4o)
LLM_MODEL=gpt-4o

# Modelo de reranking (padrão: BAAI/bge-reranker-v2-m3)
RERANKER_MODEL=BAAI/bge-reranker-v2-m3


CHROMA_HOST="localhost"
CHROMA_PORT="8000"

# ── Banco de Dados Relacional (PostgreSQL) ─────────────────────────────────────
# Credenciais usadas pelo container postgres (docker-compose.yml) e pela app.
POSTGRES_USER="univasf"
POSTGRES_PASSWORD="univasf"
POSTGRES_DB="univasf"

# String de conexão usada pela aplicação. Em Docker, o serviço `api` sobrescreve
# esta variável automaticamente para apontar para o host `postgres` (ver
# docker-compose.yml). Para rodar localmente fora do Docker, suba o banco com
# `docker-compose up -d postgres` e mantenha o valor abaixo (porta mapeada 5432).
DATABASE_URL="postgresql+psycopg2://univasf:univasf@localhost:5432/univasf"

# Cloudflare Tunnel Token (Opcional - para URL fixa)
# Se não preencher, o tunnel não iniciará.
TUNNEL_TOKEN="";